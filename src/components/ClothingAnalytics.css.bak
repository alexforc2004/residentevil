/* Clothing Analytics - Dark Theme with Neon Pink Accents */

.clothing-analytics-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.97);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  overflow-y: auto;
  padding: 20px;
}

.clothing-analytics-modal {
  background: linear-gradient(145deg, #0d0d0d 0%, #1a0a1a 50%, #0d0d0d 100%);
  border-radius: 24px;
  padding: 40px;
  max-width: 1400px;
  width: 100%;
  max-height: 95vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 
    0 0 60px rgba(255, 20, 147, 0.15),
    0 0 100px rgba(255, 20, 147, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 20, 147, 0.2);
}

.clothing-analytics-modal::-webkit-scrollbar {
  width: 8px;
}

.clothing-analytics-modal::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 4px;
}

.clothing-analytics-modal::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #FF1493, #FF69B4);
  border-radius: 4px;
}

.close-clothing-analytics {
  position: absolute;
  top: 20px;
  right: 20px;
  background: rgba(255, 20, 147, 0.1);
  border: 1px solid rgba(255, 20, 147, 0.3);
  color: #FF1493;
  font-size: 20px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
  z-index: 10;
}

.close-clothing-analytics:hover {
  background: rgba(255, 20, 147, 0.3);
  transform: rotate(90deg) scale(1.1);
  box-shadow: 0 0 20px rgba(255, 20, 147, 0.5);
}

/* Header */
.clothing-header {
  margin-bottom: 40px;
  padding-bottom: 30px;
  border-bottom: 1px solid rgba(255, 20, 147, 0.2);
}

.clothing-header-content {
  display: flex;
  align-items: center;
  gap: 30px;
}

.character-badge {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid;
  position: relative;
  flex-shrink: 0;
}

.character-badge img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.badge-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120%;
  height: 120%;
  border-radius: 50%;
  filter: blur(20px);
  opacity: 0.4;
  z-index: -1;
  animation: badgePulse 2s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.5; transform: translate(-50%, -50%) scale(1.1); }
}

.header-text h2 {
  font-size: 42px;
  font-weight: 900;
  color: #fff;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 3px;
  background: linear-gradient(90deg, #fff, #FF1493);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.character-name {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.7);
  margin: 8px 0;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.version-badge {
  display: inline-block;
  padding: 6px 16px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.8);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.version-badge.re9 {
  background: linear-gradient(135deg, rgba(255, 20, 147, 0.3), rgba(255, 105, 180, 0.2));
  border-color: #FF1493;
  color: #FF1493;
  box-shadow: 0 0 15px rgba(255, 20, 147, 0.3);
  animation: re9Glow 2s ease-in-out infinite;
}

@keyframes re9Glow {
  0%, 100% { box-shadow: 0 0 15px rgba(255, 20, 147, 0.3); }
  50% { box-shadow: 0 0 25px rgba(255, 20, 147, 0.5); }
}

/* Category Filter */
.category-filter {
  display: flex;
  gap: 12px;
  margin-bottom: 35px;
  flex-wrap: wrap;
  justify-content: center;
}

.category-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 15px 20px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
  min-width: 90px;
}

.category-btn:hover {
  background: rgba(255, 20, 147, 0.1);
  border-color: rgba(255, 20, 147, 0.3);
  transform: translateY(-3px);
}

.category-btn.active {
  background: rgba(255, 20, 147, 0.15);
  border-color: #FF1493;
  box-shadow: 0 0 20px rgba(255, 20, 147, 0.2);
}

.cat-icon {
  font-size: 24px;
}

.cat-name {
  font-size: 11px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.category-btn.active .cat-name {
  color: #FF1493;
}

/* Outfits Grid */
.outfits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 25px;
  margin-bottom: 40px;
}

.outfit-card {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  position: relative;
}

.outfit-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.outfit-card:hover {
  transform: translateY(-8px);
  border-color: var(--accent-color);
  box-shadow: 
    0 20px 40px rgba(0, 0, 0, 0.4),
    0 0 30px rgba(255, 20, 147, 0.15);
}

.outfit-card:hover::before {
  opacity: 1;
}

.outfit-card.selected {
  border-color: var(--accent-color);
  box-shadow: 
    0 0 40px rgba(255, 20, 147, 0.2),
    inset 0 0 30px rgba(255, 20, 147, 0.05);
}

.outfit-image-container {
  position: relative;
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.outfit-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.outfit-icon {
  font-size: 64px;
  filter: drop-shadow(0 0 20px rgba(255, 20, 147, 0.5));
  animation: floatIcon 3s ease-in-out infinite;
}

@keyframes floatIcon {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.outfit-glow {
  position: absolute;
  bottom: -50%;
  left: 50%;
  transform: translateX(-50%);
  width: 80%;
  height: 100px;
  filter: blur(40px);
  opacity: 0.3;
  border-radius: 50%;
}

.outfit-info {
  padding: 20px;
}

.outfit-name {
  font-size: 18px;
  font-weight: 700;
  color: #fff;
  margin: 0 0 8px 0;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.outfit-version {
  display: inline-block;
  padding: 4px 10px;
  background: linear-gradient(135deg, rgba(255, 20, 147, 0.3), rgba(255, 105, 180, 0.2));
  border: 1px solid #FF1493;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 700;
  color: #FF1493;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 10px;
}

.outfit-description {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.5);
  margin: 0;
  line-height: 1.5;
}

/* Dimensions Panel */
.dimensions-panel {
  overflow: hidden;
  background: rgba(0, 0, 0, 0.3);
  border-top: 1px solid rgba(255, 20, 147, 0.2);
}

.dimensions-panel h4 {
  font-size: 12px;
  font-weight: 700;
  color: #FF1493;
  margin: 0;
  padding: 15px 20px 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.dimensions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  padding: 0 20px 20px;
}

.dimension-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 10px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.dim-label {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.dim-value {
  font-size: 16px;
  font-weight: 700;
  color: #FF1493;
}

/* Footer Stats */
.clothing-footer {
  display: flex;
  justify-content: center;
  gap: 60px;
  padding-top: 30px;
  border-top: 1px solid rgba(255, 20, 147, 0.2);
}

.footer-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.footer-value {
  font-size: 32px;
  font-weight: 900;
  color: #fff;
}

.footer-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .clothing-analytics-modal {
    padding: 30px;
    max-width: 95%;
  }
  
  .outfits-grid {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }
  
  .header-text h2 {
    font-size: 36px;
  }
}

@media (max-width: 768px) {
  .clothing-analytics-modal {
    padding: 20px;
    border-radius: 16px;
  }
  
  .clothing-header-content {
    flex-direction: column;
    text-align: center;
  }
  
  .header-text h2 {
    font-size: 28px;
    letter-spacing: 1px;
  }
  
  .character-name {
    font-size: 16px;
  }
  
  .character-badge {
    width: 80px;
    height: 80px;
  }
  
  .category-filter {
    gap: 8px;
  }
  
  .category-btn {
    padding: 12px 15px;
    min-width: 70px;
  }
  
  .cat-icon {
    font-size: 20px;
  }
  
  .cat-name {
    font-size: 9px;
  }
  
  .outfits-grid {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 15px;
  }
  
  .outfit-image-container {
    height: 160px;
  }
  
  .outfit-icon {
    font-size: 48px;
  }
  
  .outfit-info {
    padding: 15px;
  }
  
  .outfit-name {
    font-size: 15px;
  }
  
  .outfit-description {
    font-size: 12px;
  }
  
  .clothing-footer {
    gap: 30px;
    flex-wrap: wrap;
  }
  
  .footer-value {
    font-size: 24px;
  }
  
  .footer-label {
    font-size: 10px;
  }
}

@media (max-width: 480px) {
  .clothing-analytics-overlay {
    padding: 10px;
  }
  
  .clothing-analytics-modal {
    padding: 15px;
  }
  
  .header-text h2 {
    font-size: 22px;
  }
  
  .character-badge {
    width: 60px;
    height: 60px;
  }
  
  .category-filter {
    justify-content: flex-start;
    overflow-x: auto;
    flex-wrap: nowrap;
    padding-bottom: 10px;
    -webkit-overflow-scrolling: touch;
  }
  
  .category-btn {
    flex-shrink: 0;
  }
  
  .outfits-grid {
    grid-template-columns: 1fr;
  }
  
  .dimensions-grid {
    grid-template-columns: 1fr;
  }
  
  .clothing-footer {
    gap: 20px;
  }
}

/* Neon Line Animation */
@keyframes neonLine {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.outfit-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
  transform: translateX(-100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.outfit-card:hover::after {
  opacity: 1;
  animation: neonLine 1.5s ease-in-out infinite;
}
