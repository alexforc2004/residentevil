/* Portfolio Overlay */
.portfolio-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  overflow-y: auto;
  overflow-x: hidden;
}

/* Three.js Canvas Background */
.portfolio-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

/* Animated Gradient Background */
.portfolio-gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #0a0a0a 0%, #1a0a1a 25%, #2a0a2a 50%, #1a0a1a 75%, #0a0a0a 100%);
  background-size: 400% 400%;
  animation: gradientShift 15s ease infinite;
  z-index: 0;
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* Close Button */
.portfolio-close {
  position: fixed;
  top: 2rem;
  right: 2rem;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: rgba(255, 20, 147, 0.1);
  backdrop-filter: blur(10px);
  border: 2px solid #ff1493;
  color: #ff1493;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  transition: all 0.3s ease;
  box-shadow: 0 0 20px rgba(255, 20, 147, 0.3);
}

.portfolio-close:hover {
  background: rgba(255, 20, 147, 0.2);
  box-shadow: 0 0 30px rgba(255, 20, 147, 0.6);
}

/* Container */
.portfolio-container {
  position: relative;
  z-index: 10;
  max-width: 1400px;
  margin: 0 auto;
  padding: 4rem 2rem;
  min-height: 100vh;
}

/* Header */
.portfolio-header {
  margin-bottom: 3rem;
  text-align: center;
}

.portfolio-title-wrapper {
  display: inline-block;
  padding: 2rem 3rem;
  background: rgba(255, 20, 147, 0.05);
  backdrop-filter: blur(20px);
  border-radius: 20px;
  border: 2px solid rgba(255, 20, 147, 0.3);
  box-shadow: 0 8px 32px rgba(255, 20, 147, 0.2);
}

.portfolio-title {
  font-size: 4rem;
  font-weight: 900;
  background: linear-gradient(135deg, #ff1493 0%, #ff69b4 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin: 0;
  letter-spacing: 0.1em;
  text-shadow: 0 0 30px rgba(255, 20, 147, 0.5);
}

.portfolio-subtitle {
  font-size: 1.5rem;
  color: #ff69b4;
  margin: 0.5rem 0 0 0;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 300;
}

/* Main Grid */
.portfolio-grid {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 2rem;
  align-items: start;
}

/* Left Column */
.portfolio-left {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* Stats Grid */
.portfolio-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.portfolio-stat-card {
  background: rgba(255, 20, 147, 0.05);
  backdrop-filter: blur(20px);
  border: 2px solid rgba(255, 20, 147, 0.3);
  border-radius: 15px;
  padding: 1.5rem;
  text-align: center;
  transition: all 0.3s ease;
  box-shadow: 0 4px 20px rgba(255, 20, 147, 0.1);
}

.portfolio-stat-card:hover {
  border-color: #ff1493;
  box-shadow: 0 8px 30px rgba(255, 20, 147, 0.3);
  transform: translateY(-5px);
}

.stat-icon {
  font-size: 2rem;
  margin-bottom: 0.5rem;
  filter: drop-shadow(0 0 10px #ff1493);
}

.stat-value {
  font-size: 1.8rem;
  font-weight: 700;
  color: #ff1493;
  margin-bottom: 0.3rem;
  text-shadow: 0 0 10px rgba(255, 20, 147, 0.5);
}

.stat-label {
  font-size: 0.9rem;
  color: #ff69b4;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 300;
}

/* Bio Card */
.portfolio-bio-card {
  background: rgba(255, 20, 147, 0.05);
  backdrop-filter: blur(20px);
  border: 2px solid rgba(255, 20, 147, 0.3);
  border-radius: 20px;
  padding: 2rem;
  box-shadow: 0 8px 32px rgba(255, 20, 147, 0.2);
}

.bio-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #ff1493;
  margin: 0 0 1rem 0;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.bio-text {
  font-size: 1rem;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
}

/* Right Column - Gallery */
.portfolio-right {
  width: 100%;
}

.portfolio-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

.gallery-item {
  cursor: pointer;
  border-radius: 15px;
  overflow: hidden;
  background: rgba(255, 20, 147, 0.05);
  backdrop-filter: blur(20px);
  border: 2px solid rgba(255, 20, 147, 0.3);
  transition: all 0.3s ease;
  box-shadow: 0 4px 20px rgba(255, 20, 147, 0.1);
}

.gallery-item:hover {
  border-color: #ff1493;
  box-shadow: 0 8px 40px rgba(255, 20, 147, 0.4);
}

.gallery-image-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
}

.gallery-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.gallery-item:hover .gallery-image {
  transform: scale(1.1);
}

.gallery-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, transparent 100%);
  padding: 1.5rem;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.gallery-item:hover .gallery-overlay {
  transform: translateY(0);
}

.gallery-category {
  font-size: 0.75rem;
  color: #ff1493;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-weight: 600;
}

.gallery-title {
  font-size: 1.1rem;
  color: white;
  font-weight: 600;
}

/* Image Modal */
.image-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.95);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  cursor: pointer;
}

.modal-content {
  max-width: 90vw;
  max-height: 90vh;
  background: rgba(255, 20, 147, 0.1);
  backdrop-filter: blur(20px);
  border: 2px solid #ff1493;
  border-radius: 20px;
  overflow: hidden;
  cursor: default;
  box-shadow: 0 0 60px rgba(255, 20, 147, 0.5);
}

.modal-content img {
  width: 100%;
  height: auto;
  max-height: 70vh;
  object-fit: contain;
  display: block;
}

.modal-info {
  padding: 1.5rem;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.modal-category {
  font-size: 0.9rem;
  color: #ff1493;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-weight: 600;
}

.modal-title {
  font-size: 1.5rem;
  color: white;
  margin: 0;
  font-weight: 700;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .portfolio-grid {
    grid-template-columns: 350px 1fr;
  }
  
  .portfolio-title {
    font-size: 3rem;
  }
}

@media (max-width: 1024px) {
  .portfolio-grid {
    grid-template-columns: 1fr;
  }
  
  .portfolio-stats-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  
  .portfolio-gallery {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }
}

@media (max-width: 768px) {
  .portfolio-container {
    padding: 3rem 1.5rem;
  }
  
  .portfolio-title {
    font-size: 2.5rem;
  }
  
  .portfolio-subtitle {
    font-size: 1.2rem;
  }
  
  .portfolio-title-wrapper {
    padding: 1.5rem 2rem;
  }
  
  .portfolio-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .portfolio-gallery {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  
  .portfolio-close {
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
  }
}

@media (max-width: 480px) {
  .portfolio-container {
    padding: 2rem 1rem;
  }
  
  .portfolio-title {
    font-size: 2rem;
  }
  
  .portfolio-subtitle {
    font-size: 1rem;
  }
  
  .portfolio-title-wrapper {
    padding: 1rem 1.5rem;
  }
  
  .portfolio-gallery {
    grid-template-columns: 1fr;
  }
  
  .stat-value {
    font-size: 1.5rem;
  }
  
  .stat-label {
    font-size: 0.8rem;
  }
}

@media (max-width: 375px) {
  .portfolio-title {
    font-size: 1.8rem;
  }
  
  .portfolio-stats-grid {
    gap: 0.75rem;
  }
  
  .portfolio-stat-card {
    padding: 1rem;
  }
  
  .bio-text {
    font-size: 0.9rem;
  }
}
