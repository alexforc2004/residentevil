.power-analytics-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  overflow-y: auto;
  padding: 40px 20px;
}

.power-analytics-modal {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 20px;
  padding: 40px;
  max-width: 1400px;
  width: 100%;
  position: relative;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.close-analytics {
  position: absolute;
  top: 20px;
  right: 20px;
  background: rgba(255, 255, 255, 0.1);
  border: none;
  color: #fff;
  font-size: 24px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.close-analytics:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: rotate(90deg);
}

.analytics-header {
  text-align: center;
  margin-bottom: 40px;
}

.analytics-header h2 {
  font-size: 48px;
  font-weight: 900;
  color: #fff;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.character-title {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.analytics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.analytics-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15px;
  padding: 25px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.analytics-card h3 {
  font-size: 18px;
  font-weight: 700;
  color: #fff;
  margin: 0 0 20px 0;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Profile Card */
.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.profile-image-container {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  overflow: hidden;
  border: 4px solid rgba(255, 255, 255, 0.2);
  margin-bottom: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.profile-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  position: relative;
  z-index: 2;
}

.profile-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180px;
  height: 180px;
  border-radius: 50%;
  filter: blur(40px);
  z-index: 1;
  animation: profilePulse 3s ease-in-out infinite;
}

@keyframes profilePulse {
  0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.7; transform: translate(-50%, -50%) scale(1.15); }
}

.profile-stats {
  width: 100%;
  margin-top: 20px;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.stat-label {
  color: rgba(255, 255, 255, 0.6);
  font-size: 14px;
}

.stat-value {
  color: #fff;
  font-weight: 700;
  font-size: 14px;
}

/* Power Level Card */
.power-level-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.power-circle {
  position: relative;
  width: 200px;
  height: 200px;
  margin-top: 20px;
}

.power-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.power-number {
  display: block;
  font-size: 48px;
  font-weight: 900;
  color: #fff;
}

.power-label {
  display: block;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Stats Card */
.stats-card {
  grid-column: span 2;
}

.stats-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.stat-row {
  display: grid;
  grid-template-columns: 30px 120px 1fr 50px;
  align-items: center;
  gap: 15px;
}

.stat-icon {
  font-size: 20px;
}

.stat-name {
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}

.stat-bar {
  height: 10px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 5px;
  overflow: hidden;
}

.stat-fill {
  height: 100%;
  border-radius: 5px;
  transition: width 0.8s ease;
}

.stat-number {
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  text-align: right;
}

/* Skills Card */
.skills-card {
  grid-column: span 2;
}

.skills-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.skill-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skill-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.skill-name {
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}

.skill-level {
  color: rgba(255, 255, 255, 0.8);
  font-size: 14px;
  font-weight: 700;
}

.skill-bar {
  height: 12px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  overflow: hidden;
}

.skill-fill {
  height: 100%;
  border-radius: 6px;
  transition: width 0.8s ease;
}

/* Rage Card */
.rage-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rage-container {
  display: flex;
  align-items: center;
  gap: 30px;
  margin-top: 20px;
}

.rage-bar-vertical {
  width: 60px;
  height: 200px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30px;
  overflow: hidden;
  position: relative;
}

.rage-fill-vertical {
  position: absolute;
  bottom: 0;
  width: 100%;
  border-radius: 30px;
  transition: height 1s ease;
}

.rage-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rage-value {
  font-size: 48px;
  font-weight: 900;
  color: #fff;
}

.rage-label {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Chart Card */
.chart-card {
  grid-column: span 2;
}

.chart-container {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 200px;
  gap: 20px;
  padding: 20px 0;
}

.chart-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  height: 100%;
}

.chart-fill {
  width: 100%;
  background: linear-gradient(to top, rgba(59, 130, 246, 0.8), rgba(59, 130, 246, 1));
  border-radius: 8px 8px 0 0;
  transition: height 0.8s ease;
  position: relative;
  margin-top: auto;
}

.chart-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
}

/* Responsive */
@media (max-width: 1200px) {
  .analytics-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .stats-card,
  .skills-card,
  .chart-card {
    grid-column: span 2;
  }
}

@media (max-width: 768px) {
  .analytics-grid {
    grid-template-columns: 1fr;
  }
  
  .stats-card,
  .skills-card,
  .chart-card {
    grid-column: span 1;
  }
  
  .power-analytics-modal {
    padding: 20px;
  }
  
  .analytics-header h2 {
    font-size: 32px;
  }
}